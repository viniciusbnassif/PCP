<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp">

    <com.google.android.material.divider.MaterialDivider
        android:id="@+id/div"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@+id/CL"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />



    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/CL"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/div">

        <TextView
            android:id="@+id/textView3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Digite quantas caixas do produto existem por pallet"
            app:layout_constraintBottom_toTopOf="@+id/optionsCL"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/optionsCL"
            app:layout_constraintTop_toTopOf="parent"></TextView>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/optionsCL"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintBottom_toTopOf="@+id/qtdView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView3">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/opt45"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:backgroundTint="@color/colorPrimaryContainer"
                android:insetBottom="0dp"
                android:text="45 cx"
                app:cornerRadius="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/opt48"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeColor="@color/colorOnPrimaryContainer" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/opt48"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="@color/colorPrimaryContainer"
                android:insetBottom="0dp"
                android:text="48 cx"
                app:cornerRadius="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/opt60"
                app:layout_constraintStart_toEndOf="@+id/opt45"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeColor="@color/colorOnPrimaryContainer" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/opt60"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="@color/colorPrimaryContainer"
                android:insetBottom="0dp"
                android:text="60 cx"
                app:cornerRadius="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/opt64"
                app:layout_constraintStart_toEndOf="@+id/opt48"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeColor="@color/colorOnPrimaryContainer" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/opt64"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:backgroundTint="@color/colorPrimaryContainer"
                android:insetBottom="0dp"
                android:text="64 cx"
                app:cornerRadius="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/opt60"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeColor="@color/colorOnPrimaryContainer" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/subt1"
            style="@style/Widget.Material3.Button.OutlinedButton.Icon"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="9dp"
            android:layout_marginEnd="4dp"
            android:backgroundTint="@color/colorPrimaryContainer"
            android:iconTint="@color/colorOnPrimaryContainer"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:cornerRadius="5dp"
            app:icon="@drawable/rounded_remove_24"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="50dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/qtdView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/optionsCL"
            app:layout_constraintWidth_percent="0.24"
            app:strokeColor="@color/colorOnPrimaryContainer" />


        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/qtdView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:helperText=""
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/soma1"
            app:layout_constraintStart_toEndOf="@id/subt1"
            app:layout_constraintTop_toBottomOf="@+id/optionsCL"
            app:layout_constraintWidth_percent="0.49">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/qtd"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:inputType="number|numberDecimal"
                android:padding="8dp"
                android:text="0"
                android:textAlignment="center"
                android:textSize="44sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/soma1"
            style="@style/Widget.Material3.Button.OutlinedButton.Icon"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="4dp"
            android:layout_marginTop="9dp"
            android:backgroundTint="@color/colorPrimaryContainer"
            android:iconTint="@color/colorOnPrimaryContainer"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:cornerRadius="5dp"
            app:icon="@drawable/rounded_add_24"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="50dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/qtdView"
            app:layout_constraintTop_toBottomOf="@+id/optionsCL"
            app:layout_constraintWidth_percent="0.24"
            app:strokeColor="@color/colorOnPrimaryContainer" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>